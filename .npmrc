# Boss, ye apni bouncer policy hai! 
# Agar package.json me likha Node/pnpm version Vercel ya local PC par match nahi kiya, to seedha entry ban. No compromise.
engine-strict=true

# Dependency ka aapas me lafda (version mismatch) hone par warning/error deke rone ka nahi, ignore marne ka.
strict-peer-dependencies=false

# Jo dependency missing hai, usko chilla chilla ke mangne ke bajaye, apne aap download karke chipkane ka system hai ye.
auto-install-peers=true
